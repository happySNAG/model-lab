{
  "name": "cernum",
  "productName": "Cernum",
  "version": "0.2.1",
  "description": "Test. Discern. Decide. A desktop benchmarking environment for comparing AI models — local runtimes and frontier CLIs — on repeatable, deterministic evaluations.",
  "keywords": [
    "llm",
    "benchmark",
    "evaluation",
    "ollama",
    "local-ai",
    "electron",
    "desktop",
    "model-comparison",
    "macos",
    "windows",
    "cernum",
    "frontier-models",
    "opencode"
  ],
  "homepage": "https://github.com/happySNAG/model-lab#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/happySNAG/model-lab.git"
  },
  "bugs": {
    "url": "https://github.com/happySNAG/model-lab/issues"
  },
  "main": "./out/main/index.js",
  "author": "Model Lab contributors",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c test/e2e/playwright.config.ts",
    "test:all": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "dist:mac:x64": "npm run build && electron-builder --mac --x64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:all": "npm run build && electron-builder --mac --win",
    "dist:dir": "npm run build && electron-builder --dir",
    "smoke:mac": "bash scripts/macos-smoke.sh",
    "cernum": "tsx src/cli/cernum.ts",
    "screenshots": "npm run build && playwright test -c test/e2e/screenshots.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
